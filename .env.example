SMARTCLINIC_DATABASE_URL=sqlite:///./example.db
SMARTCLINIC_JWT_SECRET=change-me-to-a-long-random-secret
SMARTCLINIC_JWT_EXPIRE_MINUTES=60
SMARTCLINIC_CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Vector backend: elasticsearch | milvus (vector dims = 1536)
SMARTCLINIC_VECTOR_BACKEND=elasticsearch
SMARTCLINIC_ES_HOST=
SMARTCLINIC_MILVUS_URI=
SMARTCLINIC_MILVUS_TOKEN=

# Optional — missing keys return HTTP 503 on related endpoints only
SMARTCLINIC_SENDER_EMAIL=
SMARTCLINIC_SENDER_PASSWORD=
SMARTCLINIC_OPENAI_API_URL=
SMARTCLINIC_OPENAI_API_KEY=
SMARTCLINIC_MODEL_LLM_ID=
SMARTCLINIC_MODEL_EMBED_ID=
